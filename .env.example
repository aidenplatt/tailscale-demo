# Copy this file to .env and fill in a real value before running docker compose.
# Generate a key at: https://login.tailscale.com/admin/settings/keys
# Tip: use a reusable, ephemeral auth key tagged tag:server so the "web"
# node cleans itself up automatically when the container stops.
#
# NOTE: only ONE key is needed here. The "client" node in this setup is
# your own laptop, connected via the Tailscale app (not an auth key) - just
# make sure your laptop is tagged tag:client in the admin console.

TS_AUTHKEY_SERVER=tskey-auth-xxxxxxxxxxxx
